{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./",
    "declaration": false,
    "allowJs": true
  },
  "include": ["./**/*.ts", ".//**/*.js"],
  "exclude": ["node_modules", "dist"]
}
